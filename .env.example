# Resend — used by the contact form server function (src/routes/contact.tsx)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Where contact form submissions are delivered
CONTACT_TO_EMAIL=4firsttechnologieslimited@gmail.com

# Sender address. Must be on a domain verified in Resend.
# "onboarding@resend.dev" works for testing but only delivers to your own Resend account email.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Supabase — CMS read layer (src/lib/cms.ts), content edited in ft-digital-admin.
# Anon key only; content is served through published-row RLS policies. If unset, the
# site renders from src/content/defaults.ts and still works.
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...

# ── Careers & Recruitment ───────────────────────────────────────────────────
# Server-only. Applications (and CV uploads) are written with the service-role key because
# applicant data has no public RLS policies. NEVER expose this to the browser / VITE_*.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Public URL of ft-digital-admin; used for the "open application" link in notification emails.
ADMIN_URL=https://admin.4firsttechnologies.com
# Fallback recipient if no notification email is set in Admin -> Settings -> Recruitment.
CAREERS_TO_EMAIL=careers@4firsttechnologies.com
