# Resend — used by the contact form server function (src/routes/contact.tsx)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Where contact form submissions are delivered
CONTACT_TO_EMAIL=4firsttechnologieslimited@gmail.com

# Sender address. Must be on a domain verified in Resend.
# "onboarding@resend.dev" works for testing but only delivers to your own Resend account email.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Supabase — CMS read layer (src/lib/cms.ts), content edited in ft-digital-admin.
# Anon key only; content is served through published-row RLS policies. If unset, the
# site renders from src/content/defaults.ts and still works.
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
